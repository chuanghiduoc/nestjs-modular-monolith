{
  "name": "nestjs-modular-monolith",
  "version": "0.1.0",
  "description": "Enterprise SaaS modular monolith - BullMQ workers, transactional outbox and three runtime roles",
  "scripts": {
    "test": "vitest run --project unit",
    "dev:all": "bash scripts/dev.sh all",
    "dev": "bash scripts/dev.sh api",
    "dev:worker": "bash scripts/dev.sh worker",
    "dev:scheduler": "bash scripts/dev.sh scheduler",
    "infra:up": "docker compose --env-file docker/compose.env -f docker/compose.dev.yml up -d",
    "infra:down": "docker compose --env-file docker/compose.env -f docker/compose.dev.yml down",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "clean": "rimraf dist coverage node_modules/.cache",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"docs/**/*.md\" \"*.json\" \"*.mjs\" \"*.cjs\" && prisma format",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"docs/**/*.md\" \"*.json\" \"*.mjs\" \"*.cjs\" && prisma format --schema prisma/schema.prisma",
    "boundaries": "depcruise src",
    "boundaries:graph": "depcruise --output-type dot src",
    "test:int": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run --coverage",
    "test:watch": "vitest --project unit",
    "verify": "pnpm format:check && pnpm lint && pnpm boundaries && pnpm typecheck && pnpm typecheck:ts6 && pnpm test:all",
    "doctor": "bash scripts/doctor.sh",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:diff": "prisma migrate diff --from-config-datasource --to-schema prisma --exit-code",
    "gen:module": "bash scripts/gen-module.sh",
    "start:api": "node dist/main.api.js",
    "start:worker": "node dist/main.worker.js",
    "start:scheduler": "node dist/main.scheduler.js",
    "start:all": "node dist/main.all.js",
    "infra:logs": "docker compose --env-file docker/compose.env -f docker/compose.dev.yml logs -f",
    "typecheck:ts6": "tsc6 -p tsconfig.json --noEmit",
    "backup": "bash scripts/backup.sh"
  },
  "license": "MIT",
  "type": "commonjs",
  "packageManager": "pnpm@11.18.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chuanghiduoc/nestjs-modular-monolith.git"
  },
  "bugs": {
    "url": "https://github.com/chuanghiduoc/nestjs-modular-monolith/issues"
  },
  "homepage": "https://github.com/chuanghiduoc/nestjs-modular-monolith#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-fastify": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "~1.6.30",
    "bullmq": "5.81.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.12.1",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "magic-bytes.js": "^1.13.1",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^9.1.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^11.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^11.2.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.16.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.11.0",
    "lefthook": "^2.1.12",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  },
  "imports": {
    "#bootstrap/*": "./dist/bootstrap/*/index.js",
    "#composition/*": "./dist/composition/*/index.js",
    "#contracts/*": "./dist/contracts/*/index.js",
    "#modules/*": "./dist/modules/*/index.js",
    "#platform/*": "./dist/platform/*/index.js",
    "#shared/*": "./dist/shared/*/index.js"
  }
}
