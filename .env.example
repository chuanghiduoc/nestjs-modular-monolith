NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://app:app@localhost:5432/app
DATABASE_DIRECT_URL=
DATABASE_POOL_MAX=10
DB_PASSWORD_FILE=
HEALTH_PORT=3001

PORT=3000
API_PREFIX=api
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:5173
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:5173
HTTP_BODY_LIMIT_BYTES=1048576
HTTP_REQUEST_TIMEOUT_MS=30000
TRUST_INBOUND_REQUEST_ID=false
DEPLOYMENT_TOPOLOGY=direct
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_ACCOUNT_RATE_LIMIT_MAX=5
AUTH_ACCOUNT_RATE_LIMIT_WINDOW_MS=900000
AUTH_SESSION_RATE_LIMIT_MAX=60
AUTH_SESSION_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000
METRICS_ALLOW_CIDRS=127.0.0.1/32,::1/128
METRICS_CACHE_TTL_SECONDS=10
AUDIT_RETENTION_DAYS=365
UPLOAD_MAX_FILE_BYTES=10485760
BILLING_WEBHOOK_SECRET=

QUEUE_CONCURRENCY=5
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
# s3-presigned (production) or local (writes to disk, no object storage needed)
FILE_DRIVER=s3-presigned
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=app-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

OUTBOX_DRAIN_INTERVAL_SECONDS=10
OUTBOX_DRAIN_BATCH_SIZE=100
OUTBOX_RETENTION_DAYS=14
TRUST_PROXY=false
