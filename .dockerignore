# Everything the image must never carry, and everything that would bust the
# build cache on an unrelated edit. The build stage regenerates dist/ and the
# Prisma client from source — a host-built copy leaking in is exactly the drift
# the CI boot smoke test exists to catch.

# Dependencies and build output — rebuilt inside the image, never copied in.
node_modules
dist
coverage
*.tsbuildinfo
.pnpm-store

# Prisma client output: generated by `prisma generate` in the build stage.
# Copying the host's copy would ship whatever schema the host last had.
src/platform/prisma/generated

# Secrets. `.env.*` covers `.env.example` too, deliberately: it is documentation
# and nothing in the image reads it. Config comes from the orchestrator.
.env
.env.*

# VCS and CI metadata.
.git
.gitignore
.github
.gitattributes

# Docs and ADRs: ~200 KB of markdown that invalidates the build context on
# every prose edit.
docs
adr
*.md

# Tests and test tooling — the image runs neither.
test
vitest.config.mts
**/*.spec.ts
**/*.integration.ts

# Local tooling config, none of which the build uses.
.dependency-cruiser.cjs
.dependency-cruiser.fixtures.cjs
eslint.config.mjs
commitlint.config.cjs
lefthook.yml
.prettierrc.json
.prettierignore
.editorconfig
.vscode
.idea
scripts

# Docker itself: the Dockerfile is passed with -f, and compose files are host-side.
docker
Dockerfile*
.dockerignore

# OS noise.
.DS_Store
Thumbs.db
